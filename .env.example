# === IA ===
ANTHROPIC_API_KEY=sk-ant-...

# === Google Drive (extraction photos clients) ===
# Option A — JSON du Service Account collé en variable d'env (recommandé Railway/prod)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Option B — Chemin vers le fichier JSON du Service Account (dev local)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# === Amazon SP-API (laisser vide pour mode démo) ===
AMAZON_SP_MODE=demo         # "demo" ou "live"
AMAZON_REFRESH_TOKEN=
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AMAZON_ROLE_ARN=
AMAZON_SELLER_ID=
